<Bindings>
  <Binding name="TEF_TOGGLE_DISPATCH" header="TEF" runOnUp="true">TEF_DispatchHotkey(keystate)</Binding>
  <Binding name="TEF_OPEN_DISPATCH_GATE_1" runOnUp="true">TEF_OpenDispatchGate(1, keystate)</Binding>
  <Binding name="TEF_OPEN_DISPATCH_GATE_2" runOnUp="true">TEF_OpenDispatchGate(2, keystate)</Binding>
  <Binding name="TEF_TOGGLE_PRACTICE" header="TEF_LEGACY">TEF_ToggleDispatchIntent()</Binding>
  <Binding name="TEF_TOGGLE_CONTINUOUS">TEF_ToggleDispatchIntent()</Binding>
  <Binding name="TEF_TOGGLE_PERMISSION" header="TEF_TEST">TEF_PermissionToggle()</Binding>
  <Binding name="TEF_REQUEST_CURRENT">TEF_RequestCurrent()</Binding>
  <Binding name="TEF_STOP_ALL">TEF_StopAll()</Binding>
</Bindings>
